rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Demo / Hackathon Rules:
    // Allows full read/write for demo simplicity while logged in,
    // or during initial development testing.
    match /{document=**} {
      allow read, write: if true; // Set to 'if isAuthenticated();' for basic auth security
    }

    // Individual collection rules when you want to enforce auth:
    match /users/{userId} {
      allow read, write: if true;
    }

    match /hospitals/{hospitalId} {
      allow read, write: if true;
    }

    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /queues/{queueId} {
      allow read, write: if true;
    }

    match /tokens/{tokenId} {
      allow read, write: if true;
    }

    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }

    match /doseLogs/{doseLogId} {
      allow read, write: if true;
    }

    match /smsMessages/{smsId} {
      allow read, write: if true;
    }
  }
}
